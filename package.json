{
  "name": "valletcontrol",
  "private": true,
  "version": "0.1.0",
  "description": "Monorepo - Controle financeiro pessoal (API NestJS hexagonal + Web Next.js + Mobile futuro)",
  "packageManager": "pnpm@10.26.0",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "dev:api": "turbo run dev --filter=@valletcontrol/api",
    "dev:web": "turbo run dev --filter=@valletcontrol/web",
    "build": "turbo run build",
    "test": "turbo run test",
    "test:api": "turbo run test --filter=@valletcontrol/api",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "format": "turbo run format",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:migrate": "pnpm --filter @valletcontrol/api prisma:migrate",
    "db:seed": "pnpm --filter @valletcontrol/api prisma:seed",
    "db:studio": "pnpm --filter @valletcontrol/api prisma:studio",
    "clean": "turbo run clean && rm -rf node_modules"
  },
  "pnpm": {
    "overrides": {
      "@angular-devkit/schematics>ora": "8.2.0",
      "@angular-devkit/core>ora": "8.2.0"
    }
  },
  "devDependencies": {
    "@babel/core": "^8.0.6",
    "@babel/preset-env": "^8.0.6",
    "@eslint/js": "^10.0.1",
    "@types/jest": "^29.5.14",
    "babel-jest": "^30.5.2",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "jest": "^29.7.0",
    "prettier": "^3.6.2",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "turbo": "^2.11.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0"
  }
}
