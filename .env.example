# ========== Application ==========
NODE_ENV=development
API_PORT=3001
API_PREFIX=api

# ========== Database ==========
DATABASE_URL=postgresql://valletcontrol:valletcontrol@localhost:5433/valletcontrol?schema=public

# ========== Auth / Security ==========
# !!! Em produção: gere via `openssl rand -base64 32` e mantenha em secret manager
JWT_SECRET=change-me-in-production-gerar-32-bytes-minimo
JWT_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=10

# ========== Frontend (Next.js) ==========
# URL base da API NestJS chamada pelo servidor/frontend
NEXT_PUBLIC_API_URL=http://localhost:3001/api

# ========== CORS da API ==========
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3002